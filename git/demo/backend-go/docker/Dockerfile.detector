# Build Stage
FROM golang:1.25-alpine AS builder

RUN apk add --no-cache git ca-certificates tzdata

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build \
    -ldflags="-w -s" \
    -o /build/clip-detector \
    ./cmd/clip-detector

# Runtime Stage
FROM alpine:latest

# ffmpeg für Audio-/Video-Analyse, streamlink (Python-Paket) um die
# öffentliche HLS-Stream-URL aus dem Twitch-Player aufzulösen — Twitch
# bietet dafür keine offizielle API (siehe Phase-B-Plan zur ToS-Einordnung).
RUN apk add --no-cache ca-certificates tzdata ffmpeg python3 py3-pip && \
    pip install --no-cache-dir --break-system-packages streamlink

RUN addgroup -g 1000 appuser && \
    adduser -D -u 1000 -G appuser appuser

WORKDIR /app

COPY --from=builder /build/clip-detector /app/clip-detector

RUN chown -R appuser:appuser /app

USER appuser

CMD ["/app/clip-detector"]
