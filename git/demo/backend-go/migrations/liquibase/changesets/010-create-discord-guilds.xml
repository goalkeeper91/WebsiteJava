<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="010-create-discord-guilds" author="Marcel">
        <comment>Erstellt die discord_guilds Tabelle mit Verknüpfung zu users(twitch_id)</comment>

        <createTable tableName="discord_guilds" remarks="Discord guilds (servers) where the bot is installed">
            <column name="id" type="BIGINT" remarks="Discord Guild ID (Snowflake)">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="owner_user_id" type="VARCHAR(255)" remarks="User who added the bot (Twitch ID)">
                <constraints foreignKeyName="fk_discord_guilds_owner"
                             referencedTableName="users"
                             referencedColumnNames="twitch_id"
                             deleteCascade="false"/> </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="icon_url" type="TEXT"/>

            <column name="member_count" type="INTEGER"/>

            <column name="bot_added_at" type="TIMESTAMP"/>

            <column name="bot_removed_at" type="TIMESTAMP"/>

            <column name="is_active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="NOW()">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex indexName="idx_discord_guilds_owner_user_id" tableName="discord_guilds">
            <column name="owner_user_id"/>
        </createIndex>

        <createIndex indexName="idx_discord_guilds_bot_added_at" tableName="discord_guilds">
            <column name="bot_added_at"/>
        </createIndex>

        <sql>
            <![CDATA[
            CREATE INDEX idx_discord_guilds_is_active ON discord_guilds(is_active) WHERE is_active = true;
            ]]>
        </sql>
    </changeSet>

</databaseChangeLog>