<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="026-add-automod-emote-threshold" author="Marcel">
        <comment>
            Emotes in genau den richtigen Momenten (Esports-Highlights o.ä.)
            sagen oft mehr aus als Text - im Gegensatz zu CAPS/Symbolen/
            Wiederholung ist die Emote-Menge, ab der es als Spam gilt, daher
            pro Channel einstellbar statt fest verdrahtet.
        </comment>

        <addColumn tableName="automod_settings">
            <column name="emote_threshold" type="INTEGER" defaultValueNumeric="6">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="automod_settings" columnName="emote_threshold"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
