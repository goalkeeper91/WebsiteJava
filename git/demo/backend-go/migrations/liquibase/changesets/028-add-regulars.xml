<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <changeSet id="028-add-regulars" author="Marcel">
        <comment>
            Regulars sind eine rein interne Klassifikation (kein echter
            Twitch-VIP-Grant): Zuschauer, deren Loyalty-Punkte die
            Kanal-Schwelle erreichen, werden automatisch von Automod
            ausgenommen (server-seitig zur Laufzeit in exempt_users
            gemergt, nie in der DB persistiert).
        </comment>

        <addColumn tableName="loyalty_settings">
            <column name="regulars_threshold" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addColumn tableName="automod_settings">
            <column name="exempt_regulars" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <rollback>
            <dropColumn tableName="loyalty_settings" columnName="regulars_threshold"/>
            <dropColumn tableName="automod_settings" columnName="exempt_regulars"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
