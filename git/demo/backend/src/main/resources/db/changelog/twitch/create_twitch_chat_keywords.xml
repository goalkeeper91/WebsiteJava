<?xml version="1.0" encoding="utf-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="create_chat_keywords" author="Marcel">
        <createTable tableName="chat_keywords">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="channel_id" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="keyword" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="response" type="TEXT">
                <constraints nullable="false"/>
            </column>

            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="chat_keywords"
                baseColumnNames="channel_id"
                referencedTableName="twitch_channels"
                referencedColumnNames="id"
                constraintName="fk_keywords_channel"
                onDelete="CASCADE"/>

        <addUniqueConstraint
                tableName="chat_keywords"
                columnNames="channel_id, keyword"
                constraintName="uq_keyword_per_channel"/>
    </changeSet>
</databaseChangeLog>
