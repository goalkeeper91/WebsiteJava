<?xml version="1.0" encoding="utf-8" ?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">
    <changeSet id="create_twitch_timers_table" author="Marcel">
        <createTable tableName="twitch_timers">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="twitch_user_id" type="VARCHAR(255)"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(255)"/> <column name="response" type="TEXT"><constraints nullable="false"/></column>
            <column name="interval_minutes" type="INTEGER"><constraints nullable="false"/></column>
            <column name="min_chat_messages" type="INTEGER" defaultValueNumeric="0"/>
            <column name="is_enabled" type="BOOLEAN" defaultValueBoolean="true"/>
        </createTable>
    </changeSet>
</databaseChangeLog>