# Minimal-Konfiguration fuer einen reinen Weiterleitungs-Relay (keine echten
# Postfaecher, kein IMAP/POP) - siehe git/demo README bzw. docker-compose.prod.yml
# Kommentar beim "mailrelay"-Service fuer den Hintergrund.

myhostname = mail.goalkeeper91.de
mydomain = fuchs.goalkeeper91.de
myorigin = $mydomain

# Bewusst KEINE lokale lokale Zustellung (mydestination leer) - jede
# eingehende Adresse wird ausschliesslich ueber virtual_alias_maps aufgeloest
# und sofort weitergeleitet. Das ist der Unterschied zu einem "echten"
# Mailserver mit Postfaechern.
mydestination =
virtual_alias_domains = fuchs.goalkeeper91.de
virtual_alias_maps = hash:/etc/postfix/virtual

inet_interfaces = all
inet_protocols = ipv4
# 172.20.0.0/16 = goalkeeper_prod_network (das gemeinsame Docker-Netzwerk
# aller Container auf diesem Server, siehe docker-compose.prod.yml) - damit
# duerfen andere eigene Container (z.B. ein Django-Backend mit
# EMAIL_HOST=mailrelay) hierueber relayen, nicht nur der Relay-Container
# selbst. Docker-Netzwerke sind nach Mitgliedschaft isoliert, nicht nach
# CIDR-Groesse - das Vertrauen aufs ganze /16 ist unproblematisch, SOLANGE
# in goalkeeper_prod_network wirklich nur eigene Container haengen (zuletzt
# per "docker network inspect goalkeeper_prod_network" geprueft).
mynetworks = 127.0.0.0/8, 172.20.0.0/16

# Postfix loggt standardmaessig ueber Syslog, nicht auf stdout - "docker
# logs" zeigt davon nichts, egal ob alles laeuft oder etwas fehlschlaegt.
# maillog_file leitet Postfix' eigenes Logging direkt auf stdout um (Postfix
# >= 3.4, in Debian bookworm vorhanden).
maillog_file = /dev/stdout

# Ausgehend NICHT direkt ins offene Internet (das braeuchte eine gute
# Sende-Reputation der Server-IP, siehe Diskussion), sondern authentifiziert
# ueber Gmail selbst als Relay - das Ziel-Postfach ist ohnehin ein
# Gmail-Konto, das vertraut sich selbst. GMAIL_RELAY_USER/APP_PASSWORD
# kommen als Env-Var rein (siehe entrypoint.sh), landen nie in diesem Repo.
relayhost = [smtp.gmail.com]:587
smtp_sasl_auth_enable = yes
smtp_sasl_password_maps = hash:/etc/postfix/sasl_passwd
smtp_sasl_security_options = noanonymous
smtp_sasl_mechanism_filter = plain, login
smtp_tls_security_level = encrypt
smtp_tls_CAfile = /etc/ssl/certs/ca-certificates.crt

# Nur eigene Container (mynetworks) UND aufgeloeste virtuelle Ziele duerfen
# relayed werden - verhindert, dass dieser Server als offener Relay fuer
# fremde Domains missbraucht wird.
smtpd_relay_restrictions = permit_mynetworks, reject_unauth_destination

# Basis-Haertung gegen Spam-/Massenscan-Bots, die die auf der Website
# veroeffentlichte Adresse (fuchs-erste-hilfe@fuchs.goalkeeper91.de)
# anschreiben. Filtert nichts Legitimes weg, faengt aber einen guten Teil
# des ungezielten Bot-Traffics schon VOR der Weiterleitung an Gmail ab
# (weniger Rauschen, auch wenn Gmails eigener Spamfilter ohnehin greift).
#
# - HELO ist Pflicht und muss syntaktisch gueltig aussehen (die meisten
#   simplen Spam-Skripte senden gar kein oder ein offensichtlich falsches
#   HELO).
# - Absender-Domain muss aufloesbar sein (reject_unknown_sender_domain) -
#   filtert Faelschungen mit frei erfundenen Absenderdomains.
# - Gegenstelle wird gegen Spamhaus' oeffentliche Blocklist geprueft
#   (bekannte Spam-/Botnet-Quell-IPs). Zen ist die kombinierte Spamhaus-
#   Liste (SBL+XBL+PBL).
# - Verbindungs-Ratenlimit pro Quell-IP verhindert, dass eine einzelne
#   Quelle den Relay mit vielen parallelen/schnellen Verbindungen flutet.
smtpd_helo_required = yes
smtpd_helo_restrictions = permit_mynetworks, reject_invalid_helo_hostname, permit
smtpd_recipient_restrictions =
    permit_mynetworks,
    reject_unauth_destination,
    reject_unknown_sender_domain,
    reject_rbl_client zen.spamhaus.org,
    permit
smtpd_client_connection_rate_limit = 10
smtpd_client_connection_count_limit = 5
anvil_rate_time_unit = 60s

# Angemessene Obergrenze fuer eine einzelne Kontaktadresse ohne Anhaenge-
# Workflow - verhindert, dass jemand den Relay mit sehr grossen Mails
# (Speicher/Bandbreite) belastet, laesst aber normale Anhaenge zu.
message_size_limit = 15728640
